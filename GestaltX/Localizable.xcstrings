  "strings" : {
    "* If you previously changed Sales Region, restore your device's original sales region and apply it first." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* If you previously changed Sales Region, restore your device's original sales region and apply it first."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* اگر قبلاً منطقهٔ فروش را تغییر داده‌اید، ابتدا منطقهٔ فروش اصلی دستگاه را بازگردانید و تغییر را اعمال کنید."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* 이전에 판매 지역을 변경한 경우, 기기의 원래 판매 지역으로 복원하고 먼저 적용하십시오."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Если вы ранее меняли регион продажи, сначала верните исходный регион продажи устройства и примените изменения."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Nếu trước đây bạn đã đổi khu vực bán hàng, hãy khôi phục khu vực bán hàng ban đầu của thiết bị và áp dụng trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* 之前修改过销售地区的用户，请先改回设备原本的销售地区并应用。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* 之前修改過銷售地區的用戶，請先改回裝置原本的銷售地區並套用。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* 先前修改過銷售地區的使用者，請先改回裝置原本的銷售地區並套用。"
          }
        }
      }
    },
