    "© %@ huamidev. All rights reserved." : {

    },
    "A backup is created before each write." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup is created before each write."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از هر بار نوشتن، نسخهٔ پشتیبان ساخته می‌شود."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰기 작업 전에 매번 백업이 생성됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия создаётся перед каждой записью."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu được tạo trước mỗi lần ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次写入前会自动备份。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次寫入前會自動備份。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次寫入前會自動備份。"
          }
        }
      }
    },
    "A backup is created before writing. The result is read back and compared." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup is created before writing. The result is read back and compared."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از نوشتن، نسخهٔ پشتیبان ساخته می‌شود. نتیجه دوباره خوانده و مقایسه می‌شود."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰기 전에 백업이 생성됩니다. 기록된 결과는 다시 읽어 비교 검증됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед записью создаётся резервная копия. Затем результат считывается и сравнивается."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu được tạo trước khi ghi. Kết quả được đọc lại và so sánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入前会创建备份，写入后会回读并比较内容。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入前會創建備份，寫入後會回讀並比較內容。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫入前會建立備份，寫入後會回讀並比較內容。"
          }
        }
      }
    },
    "A correctly provisioned App Group is required. Export and backup are available for any document you can open." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A correctly provisioned App Group is required. Export and backup are available for any document you can open."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Group باید به‌درستی پیکربندی و امضا شده باشد. هر سندی که باز می‌کنید قابل صدور و پشتیبان‌گیری است."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "올바르게 프로비저닝된 App Group이 필요합니다. 열 수 있는 모든 문서에 대해 내보내기 및 백업이 가능합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется правильно подготовленная и подписанная App Group. Любой открытый документ можно экспортировать и сохранить в резервной копии."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần App Group được cấp quyền và ký đúng. Có thể xuất và sao lưu mọi tài liệu bạn mở được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要正确配置并签名 App Group。能够打开的文稿均可导出与备份。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要正確配置並簽名 App Group。能夠打開的文稿均可導出與備份。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要正確配置並簽名 App Group。能夠開啟的文稿均可匯出與備份。"
          }
        }
      }
    },
    "A device restart may be required after changing the model number." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A device restart may be required after changing the model number."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از تغییر شمارهٔ مدل ممکن است لازم باشد دستگاه را راه‌اندازی مجدد کنید."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 번호를 변경한 후 기기를 재시동해야 할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После изменения номера модели может потребоваться перезагрузка устройства."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể cần khởi động lại thiết bị sau khi đổi số kiểu máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改型号号码后可能需要重启设备。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改型號號碼後可能需要重新啟動裝置。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改型號號碼後可能需要重新啟動裝置。"
          }
        }
      }
    },
