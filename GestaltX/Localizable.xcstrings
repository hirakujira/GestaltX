        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xác minh nội dung ghi. Một số tính năng cần khởi động lại thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
