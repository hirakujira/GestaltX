    "Unverified byte-offset patches are excluded. Use supported presets or inspect individual fields." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unverified byte-offset patches are excluded. Use supported presets or inspect individual fields."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصله‌های تأییدنشده با جابه‌جایی بایت کنار گذاشته شده‌اند. از پیش‌تنظیم‌های پشتیبانی‌شده استفاده کنید یا فیلدها را جداگانه بررسی کنید."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검증되지 않은 바이트 오프셋 패치는 제외되었습니다. 지원되는 프리셋을 사용하거나 개별 필드를 직접 확인하십시오."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Непроверенные патчи по смещению байтов исключены. Используйте поддерживаемые предустановки или проверьте отдельные поля."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không sử dụng bản vá độ lệch byte chưa được xác minh. Hãy dùng thiết lập sẵn được hỗ trợ hoặc kiểm tra từng trường."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未接入未经验证的偏移补丁。你可以使用已有预设或查看具体字段。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未接入未經驗證的偏移補丁。你可以使用已有預設或查看具體字段。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未接入未經驗證的偏移補丁。你可以使用已有預設或檢視具體欄位。"
          }
        }
      }
    },
    "Use an XML plist fragment, including the array or dict tags. Nested data and numeric types are preserved." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use an XML plist fragment, including the array or dict tags. Nested data and numeric types are preserved."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از یک قطعهٔ XML plist شامل برچسب‌های array یا dict استفاده کنید. داده‌های تودرتو و نوع عددها حفظ می‌شوند."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "array 또는 dict 태그를 포함한 XML plist 조각을 사용하십시오. 중첩된 데이터 및 숫자 타입이 보존됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте фрагмент XML plist с тегами array или dict. Вложенные данные и числовые типы сохраняются."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập một đoạn XML plist có thẻ array hoặc dict. Dữ liệu lồng nhau và các kiểu số được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入包含 array 或 dict 标签的 XML plist 片段。嵌套的数据与数字类型会被保留。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入包含 array 或 dict 標籤的 XML plist 片段。嵌套的數據與數字類型會被保留。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入包含 array 或 dict 標籤的 XML plist 片段。巢狀的資料與數字型別會被保留。"
          }
        }
      }
    },
    "Use only devices you own or are authorized to manage. You are responsible for the changes you choose to apply." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use only devices you own or are authorized to manage. You are responsible for the changes you choose to apply."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط روی دستگاه‌های خودتان یا دستگاه‌هایی که مجاز به مدیریت آن‌ها هستید استفاده کنید. مسئولیت تغییراتی که اعمال می‌کنید با شماست."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인 소유이거나 관리를 위임받은 기기에서만 사용하십시오. 적용한 변경 사항에 대한 모든 책임은 사용자 본인에게 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте приложение только на своих устройствах или с разрешения владельца. Вы несёте ответственность за применяемые изменения."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ sử dụng trên thiết bị của bạn hoặc thiết bị bạn được phép quản lý. Bạn chịu trách nhiệm về các thay đổi mình áp dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你拥有或获授权管理的设备上使用，并自行承担所选修改带来的风险。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在你擁有或獲授權管理的設備上使用，並自行承擔所選修改帶來的風險。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在你擁有或獲授權管理的裝置上使用，並自行承擔所選修改帶來的風險。"
          }
        }
      }
    },
    "Use the low-performance rendering capability on iOS 26 and later." : {
