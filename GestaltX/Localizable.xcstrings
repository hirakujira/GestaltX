          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخه‌های پشتیبان دستگاه به همین نصب متصل می‌مانند. فایل‌های واردشده جدا نگه داشته می‌شوند."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 백업은 현재 설치된 앱에 연결되어 유지됩니다. 가져온 파일은 별도로 관리됩니다."
          }
