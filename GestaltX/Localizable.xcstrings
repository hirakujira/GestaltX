    "A shared plist is waiting. Save or discard your current changes, then import it." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A shared plist is waiting. Save or discard your current changes, then import it."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک فایل plist اشتراک‌گذاری‌شده در انتظار است. ابتدا تغییرات فعلی را ذخیره یا لغو کنید."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유된 plist가 대기 중입니다. 현재 변경 사항을 저장하거나 취소한 후 가져오십시오."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полученный plist ожидает импорта. Сначала сохраните или отмените текущие изменения."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có plist đã chia sẻ đang chờ nhập. Hãy lưu hoặc bỏ các thay đổi hiện tại trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有分享的 plist 等待导入，请先保存或放弃当前更改。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有分享的 plist 等待匯入，請先儲存或捨棄目前的更改。"
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有分享的 plist 等待匯入，請先儲存或捨棄目前的更改。"
          }
        }
      }
    },
