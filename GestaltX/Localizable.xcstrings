          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی به سیستم و قابلیت‌های در دسترس به نسخهٔ سیستم‌عامل، دستگاه و امضای برنامه بستگی دارد."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 접근 권한 및 사용 가능한 기능은 OS 버전, 기기 및 서명 상태에 따라 다릅니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
