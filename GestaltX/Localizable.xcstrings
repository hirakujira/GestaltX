    "Usually, changing the region code is enough. There is no need to change Sales Region." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usually, changing the region code is enough. There is no need to change Sales Region."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معمولاً تغییر کد منطقه کافی است. نیازی به تغییر منطقهٔ فروش نیست."
